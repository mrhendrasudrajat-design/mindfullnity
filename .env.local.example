# === WAJIB — Supabase (Dashboard → Settings → API) ===
# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key — aman untuk client (format baru: sb_publishable_... atau JWT lama eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# === OPSIONAL — OpenRouter (narasi AI + TTS suara panduan) ===
# Tanpa ini app tetap jalan: wizard fallback ke template lokal (lib/templates.ts), TTS skip
# Ambil di https://openrouter.ai/settings/keys (model gratis via :free)
OPENROUTER_API_KEY=sk-or-v1-xxx
# Opsional: override model LLM penulis narasi (default: z-ai/glm-5.2:free)
# OPENROUTER_SCRIPT_MODEL=z-ai/glm-5.2:free
# Opsional: pilih suara TTS Fish (default: auto)
# OPENROUTER_TTS_VOICE=

# === DOKU Checkout (paywall program 7/21/90) — server-only ===
# Tanpa DOKU key = mock mode (checkout langsung grant, tetap jalan)
# Ambil di DOKU Dashboard → Settings → API
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_API_URL=https://api-sandbox.doku.com
# Untuk prod: https://api.doku.com
# Site URL untuk callback DOKU (harus https di prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Pricing FX (ID/IDR ↔ EN/USD) ===
# Kurs untuk konversi display USD (EN). Ubah jika kurs berubah.
FX_IDR_PER_USD=16500

# === Service role (opsional — untuk DOKU webhook grant) ===
# Dibutuhkan agar webhook bisa upsert entitlements tanpa RLS. Isi jika pakai DOKU real.
SUPABASE_SECRET_KEY=sb_secret_xxx
