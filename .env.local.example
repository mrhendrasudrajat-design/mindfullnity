# Ambil dari Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (aman untuk client; format baru: sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Secret key (setara service_role) — SERVER ONLY, jangan pernah NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxx

# OpenRouter — SERVER ONLY (narasi AI + suara panduan TTS)
# Ambil di https://openrouter.ai/settings/keys (model gratis via :free)
OPENROUTER_API_KEY=sk-or-v1-xxx
# Opsional: override model LLM penulis narasi (default: z-ai/glm-5.2:free)
# OPENROUTER_SCRIPT_MODEL=z-ai/glm-5.2:free
# Opsional: pilih suara TTS (default: suara default provider fish-audio)
# OPENROUTER_TTS_VOICE=